# ===== 邮箱 IMAP 配置 =====
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=user@example.com
# 企业邮箱登录密码；若公司要求“客户端授权码”，请到网页邮箱设置里生成后填这里
IMAP_PASSWORD=
IMAP_SSL=true
# 是否校验 IMAP 服务器的 SSL 证书（企业自签证书可设为 false）
IMAP_VERIFY_SSL=true
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASSWORD=your_client_authorization_code
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_VERIFY_SSL=true
SMTP_SENT_IMAP_HOST=imap.example.com
SMTP_SENT_FOLDER=
SMTP_MAX_RECIPIENTS=100
INBOX_FOLDER=INBOX
QUARANTINE_FOLDER=隔离区
SPAM_FOLDER=垃圾邮件

# 本企业域名，用于仿冒检测（伪造公司域名的邮件会重点打击）
COMPANY_DOMAIN=example.com
# 额外的可信域名，逗号分隔（比如常打交道的客户/供应商域名）
TRUSTED_DOMAINS=trusted-partner.example
# 仅用于已由业务方明确核验的固定发件地址；硬认证失败/危险附件仍会保留风险
TRUSTED_SENDERS=verified@trusted-partner.example

# ===== 拉取策略 =====
POLL_INTERVAL_SECONDS=300
# 首次运行处理最近多少封历史邮件（避免第一次跑把收件箱全量送去 LLM）
INITIAL_FETCH_LIMIT=20

# ===== LLM 配置（DeepSeek / Kimi / 通义 / 私有网关 均兼容，改这几行即可切换）=====
# DeepSeek: https://api.deepseek.com   模型: deepseek-chat
# Kimi:     https://api.moonshot.cn/v1 模型: kimi-k2-0905-preview
# 通义:     https://dashscope.aliyuncs.com/compatible-mode/v1 模型: qwen-plus
# 自定义部署: https://model-gateway.example.com/v1 模型: your-model-id
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
# 是否校验 LLM 接口的 HTTPS 证书（内网自签网关可设为 false，公网服务建议 true）
LLM_VERIFY_SSL=true
# 模型专属额外参数，JSON 格式（如 top_k / chat_template_kwargs 等）
LLM_EXTRA_PARAMS={"chat_template_kwargs":{"enable_thinking":false}}
LLM_ANALYZE_ALL=false
MULTIMODAL_ENABLED=true
# 默认复用 LLM_MODEL；若网关为视觉模型配置了单独名称，可在此覆盖
MULTIMODAL_MODEL=
MULTIMODAL_MAX_IMAGES=2
MULTIMODAL_MAX_IMAGE_BYTES=2097152
LLM_MAX_BODY_CHARS=6000
# 送 LLM 前对手机号/身份证/银行卡号打码（企业邮件强烈建议保持 true）
REDACT_BEFORE_LLM=false

# ===== 自动处置策略 =====
# observe=仅观察不移动；review=等待人工确认；auto=自动移动高风险/垃圾邮件
ACTION_MODE=auto
# 单次拉取最多自动移动多少封，超过后触发熔断并保留在收件箱
AUTO_ACTION_MAX_PER_RUN=10

# ===== 安全评分阈值（0-100）=====
# 规则分 >= 此值：直接隔离（不等 LLM）
QUARANTINE_SCORE=70
# 规则分 >= 此值：送 LLM 复核是否钓鱼
LLM_REVIEW_SCORE=35

# ===== 本地 Web 面板 =====
WEB_HOST=127.0.0.1
WEB_PORT=8787
